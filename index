<!doctype html>
<html lang="nn">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Uoffisiell nynorsk undervisningsplanleggjar inspirert av arbeidsflyten i Spinna." />
  <title>Spinna – nynorsk prototype</title>
  <style>
    :root{
      --bg:#f4f1e9;
      --paper:#fffdf8;
      --ink:#142320;
      --muted:#63706b;
      --line:#d8ddd8;
      --accent:#146b5f;
      --accent-2:#efc65a;
      --accent-3:#dfece7;
      --danger:#9c3d35;
      --shadow:0 18px 45px rgba(22,39,34,.12);
      --radius:24px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color:var(--ink);
      background:
        radial-gradient(circle at 10% 5%, rgba(239,198,90,.18), transparent 28rem),
        radial-gradient(circle at 90% 18%, rgba(20,107,95,.10), transparent 30rem),
        var(--bg);
      min-height:100vh;
    }
    button,input,textarea,select{font:inherit}
    button{cursor:pointer}
    .app{
      min-height:100vh;
      display:grid;
      grid-template-rows:auto 1fr;
    }
    header{
      min-height:76px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:16px clamp(18px,4vw,52px);
      border-bottom:1px solid rgba(20,35,32,.10);
      background:rgba(244,241,233,.84);
      backdrop-filter:blur(10px);
      position:sticky;
      top:0;
      z-index:50;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:850;
      letter-spacing:-.04em;
      font-size:1.35rem;
    }
    .brand-mark{
      width:42px;height:42px;border-radius:50%;
      display:grid;place-items:center;
      background:var(--ink);color:white;
      box-shadow:inset 0 0 0 7px rgba(255,255,255,.10);
    }
    .brand small{
      display:block;
      font-size:.68rem;
      font-weight:650;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--muted);
      margin-top:2px;
    }
    .header-actions{display:flex;gap:10px;align-items:center}
    .btn{
      border:1px solid var(--line);
      border-radius:999px;
      background:var(--paper);
      color:var(--ink);
      padding:10px 15px;
      font-weight:750;
      transition:.18s ease;
    }
    .btn:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(22,39,34,.08)}
    .btn.primary{background:var(--ink);color:white;border-color:var(--ink)}
    .btn.ghost{background:transparent}
    .btn.danger{color:var(--danger)}
    .layout{
      display:grid;
      grid-template-columns:minmax(0,1.3fr) minmax(330px,.7fr);
      gap:24px;
      padding:clamp(18px,3vw,36px);
      max-width:1500px;
      width:100%;
      margin:0 auto;
      align-items:start;
    }
    .stage,.panel{
      background:rgba(255,253,248,.82);
      border:1px solid rgba(20,35,32,.10);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }
    .stage{
      min-height:calc(100vh - 150px);
      padding:clamp(20px,3vw,36px);
      position:relative;
      overflow:hidden;
    }
    .stage::before{
      content:"";
      position:absolute;inset:-30% auto auto -15%;
      width:360px;height:360px;border-radius:50%;
      background:rgba(239,198,90,.14);
      filter:blur(2px);
      pointer-events:none;
    }
    .eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      color:var(--accent);
      text-transform:uppercase;
      letter-spacing:.11em;
      font-size:.73rem;
      font-weight:850;
    }
    .eyebrow::before{content:"";width:22px;height:2px;background:currentColor}
    h1{
      font-size:clamp(2rem,4vw,4.6rem);
      line-height:.98;
      letter-spacing:-.065em;
      margin:12px 0 12px;
      max-width:13ch;
    }
    .lead{
      font-size:clamp(1rem,1.5vw,1.17rem);
      color:var(--muted);
      max-width:65ch;
      line-height:1.55;
      margin-bottom:22px;
    }
    .statusbar{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin:0 0 26px;
    }
    .status-pill{
      padding:8px 11px;
      border-radius:999px;
      background:var(--accent-3);
      font-weight:750;
      font-size:.86rem;
    }
    .status-pill.warn{background:#fff0be}
    .wheel-wrap{
      position:relative;
      display:grid;
      place-items:center;
      min-height:610px;
    }
    .wheel{
      position:relative;
      width:min(590px,82vw);
      aspect-ratio:1;
      border-radius:50%;
      background:
        radial-gradient(circle, var(--paper) 0 28%, transparent 28.4%),
        radial-gradient(circle, rgba(20,107,95,.08) 0 59%, transparent 59.4%),
        repeating-conic-gradient(from -90deg, rgba(20,35,32,.11) 0deg 1deg, transparent 1deg 32.727deg);
      border:1px solid rgba(20,35,32,.12);
      box-shadow:inset 0 0 0 22px rgba(255,255,255,.30), 0 20px 50px rgba(22,39,34,.10);
    }
    .wheel::after{
      content:"";
      position:absolute;
      inset:31%;
      border-radius:50%;
      border:1px dashed rgba(20,35,32,.18);
      pointer-events:none;
    }
    .center{
      position:absolute;
      inset:50% auto auto 50%;
      transform:translate(-50%,-50%);
      width:31%;aspect-ratio:1;border-radius:50%;
      display:grid;place-items:center;text-align:center;
      padding:18px;
      background:var(--ink);
      color:white;
      box-shadow:0 14px 30px rgba(20,35,32,.24);
      z-index:4;
    }
    .center strong{font-size:clamp(1.05rem,2.1vw,1.55rem);line-height:1.05}
    .center span{font-size:.72rem;opacity:.72;margin-top:4px;display:block}
    .wheel-item{
      position:absolute;
      width:31%;
      min-height:72px;
      left:50%;top:50%;
      transform:
        translate(-50%,-50%)
        rotate(var(--a))
        translateY(-230%)
        rotate(calc(-1 * var(--a)));
      border:0;
      border-radius:18px;
      padding:11px 12px;
      background:rgba(255,253,248,.94);
      color:var(--ink);
      box-shadow:0 8px 20px rgba(22,39,34,.08);
      font-size:clamp(.73rem,1.3vw,.92rem);
      font-weight:800;
      line-height:1.12;
      text-align:center;
      transition:.18s ease;
      z-index:3;
    }
    .wheel-item:hover,.wheel-item.active{
      background:var(--accent);
      color:white;
      transform:
        translate(-50%,-50%)
        rotate(var(--a))
        translateY(-230%)
        rotate(calc(-1 * var(--a)))
        scale(1.05);
    }
    .wheel-item.has-value::after{
      content:attr(data-count);
      position:absolute;
      right:-6px;top:-8px;
      width:24px;height:24px;border-radius:50%;
      display:grid;place-items:center;
      background:var(--accent-2);
      color:var(--ink);
      border:2px solid var(--paper);
      font-size:.72rem;font-weight:900;
    }
    .stage-bottom{
      display:flex;
      justify-content:center;
      gap:12px;
      flex-wrap:wrap;
      margin-top:14px;
    }
    .panel{
      position:sticky;
      top:100px;
      overflow:hidden;
      min-height:620px;
    }
    .panel-head{
      padding:22px 22px 18px;
      border-bottom:1px solid var(--line);
      background:rgba(255,255,255,.45);
    }
    .panel-head h2{font-size:1.45rem;letter-spacing:-.035em;margin:4px 0 6px}
    .panel-head p{margin:0;color:var(--muted);font-size:.93rem;line-height:1.45}
    .panel-body{
      padding:20px 22px 26px;
      max-height:calc(100vh - 210px);
      overflow:auto;
    }
    .hint{
      border:1px dashed var(--line);
      border-radius:16px;
      padding:16px;
      color:var(--muted);
      background:#fffefa;
      line-height:1.5;
    }
    .option-grid{
      display:flex;gap:9px;flex-wrap:wrap;margin:13px 0 18px
    }
    .chip{
      border:1px solid var(--line);
      background:white;
      color:var(--ink);
      padding:9px 11px;
      border-radius:999px;
      font-weight:720;
      font-size:.88rem;
      transition:.16s ease;
    }
    .chip:hover{border-color:#a9b7b1}
    .chip.selected{
      background:var(--accent);
      color:white;border-color:var(--accent);
      box-shadow:0 6px 14px rgba(20,107,95,.18);
    }
    .field{margin:16px 0}
    .field label{
      display:block;font-weight:800;font-size:.88rem;margin:0 0 7px
    }
    .field input,.field textarea,.field select{
      width:100%;
      border:1px solid var(--line);
      border-radius:14px;
      padding:11px 12px;
      color:var(--ink);
      background:white;
      outline:none;
    }
    .field input:focus,.field textarea:focus,.field select:focus{
      border-color:var(--accent);
      box-shadow:0 0 0 3px rgba(20,107,95,.10);
    }
    .field textarea{min-height:92px;resize:vertical}
    .helper{font-size:.79rem;color:var(--muted);margin-top:6px;line-height:1.35}
    .summary{
      margin-top:20px;
      border-top:1px solid var(--line);
      padding-top:18px;
    }
    .summary h3{margin:0 0 10px;font-size:.95rem}
    .summary-items{display:grid;gap:8px}
    .summary-row{
      display:flex;justify-content:space-between;gap:12px;
      padding:9px 0;border-bottom:1px solid #edf0ed;font-size:.84rem
    }
    .summary-row b{font-weight:800}
    .summary-row span{color:var(--muted);text-align:right}
    .modal-backdrop{
      position:fixed;inset:0;background:rgba(9,18,16,.48);
      display:none;place-items:center;padding:18px;z-index:100;
      backdrop-filter:blur(5px);
    }
    .modal-backdrop.show{display:grid}
    .modal{
      width:min(720px,100%);
      background:var(--paper);
      border-radius:26px;
      box-shadow:0 26px 80px rgba(0,0,0,.28);
      padding:28px;
      position:relative;
    }
    .modal h2{font-size:2rem;letter-spacing:-.045em;margin:0 0 10px}
    .modal p{color:var(--muted);line-height:1.55}
    .steps{
      display:grid;grid-template-columns:repeat(3,1fr);
      gap:12px;margin:22px 0;
    }
    .step{
      border:1px solid var(--line);
      background:white;border-radius:18px;padding:16px
    }
    .step strong{
      width:30px;height:30px;border-radius:50%;
      background:var(--accent);color:white;
      display:grid;place-items:center;margin-bottom:10px
    }
    .step b{display:block;margin-bottom:4px}
    .step span{font-size:.86rem;color:var(--muted);line-height:1.4}
    .modal-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
    .close{
      position:absolute;right:18px;top:16px;
      width:36px;height:36px;border-radius:50%;
      border:1px solid var(--line);background:white;font-size:1.25rem
    }
    .result-modal .modal{width:min(900px,100%)}
    .result{
      border:1px solid var(--line);
      background:white;border-radius:18px;
      padding:18px;
      max-height:58vh;
      overflow:auto;
    }
    .result h3{margin:18px 0 7px;font-size:1.08rem}
    .result h3:first-child{margin-top:0}
    .result p,.result li{line-height:1.55;color:#34423e}
    .result ul{padding-left:1.15rem}
    .result-toolbar{
      display:flex;justify-content:space-between;gap:10px;
      align-items:center;margin:0 0 12px;flex-wrap:wrap
    }
    .notice{
      font-size:.78rem;color:var(--muted);line-height:1.4;
      max-width:55ch;
    }
    .toast{
      position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);
      background:var(--ink);color:white;padding:11px 15px;border-radius:999px;
      opacity:0;pointer-events:none;transition:.2s ease;z-index:120;
      font-weight:750;font-size:.88rem
    }
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    @media (max-width: 980px){
      .layout{grid-template-columns:1fr}
      .panel{position:relative;top:auto;min-height:auto}
      .panel-body{max-height:none}
      .stage{min-height:auto}
      .wheel-wrap{min-height:560px}
    }
    @media (max-width: 650px){
      header{padding:12px 14px}
      .brand small{display:none}
      .header-actions .ghost{display:none}
      .layout{padding:12px}
      .stage{padding:18px 14px;border-radius:18px}
      h1{font-size:2.45rem}
      .wheel-wrap{min-height:490px}
      .wheel{width:min(460px,94vw)}
      .wheel-item{
        width:33%;min-height:58px;padding:8px 6px;font-size:.67rem;
        transform:
          translate(-50%,-50%)
          rotate(var(--a))
          translateY(-228%)
          rotate(calc(-1 * var(--a)));
      }
      .wheel-item:hover,.wheel-item.active{
        transform:
          translate(-50%,-50%)
          rotate(var(--a))
          translateY(-228%)
          rotate(calc(-1 * var(--a)))
          scale(1.03);
      }
      .steps{grid-template-columns:1fr}
      .panel{border-radius:18px}
    }
  </style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand">
      <div class="brand-mark">S</div>
      <div>
        Spinna
        <small>nynorsk prototype</small>
      </div>
    </div>
    <div class="header-actions">
      <button class="btn ghost" id="helpBtn">Slik verkar det</button>
      <button class="btn danger" id="resetBtn">Start nytt forløp</button>
    </div>
  </header>

  <main class="layout">
    <section class="stage">
      <span class="eyebrow">Undervisningsplanlegging</span>
      <h1>Set ramma. Få nye undervisningsidéar.</h1>
      <p class="lead">
        Vel struktur og fag først. Legg deretter til dei pedagogiske og didaktiske rammene
        som er relevante for elevgruppa og undervisninga di.
      </p>

      <div class="statusbar">
        <span class="status-pill" id="progressPill">0 kategoriar valde</span>
        <span class="status-pill warn" id="requiredPill">Vel struktur og fag/emne for å koma i gang</span>
      </div>

      <div class="wheel-wrap">
        <div class="wheel" id="wheel">
          <div class="center">
            <div>
              <strong>Bygg opplegget</strong>
              <span>Klikk på eit felt i hjulet</span>
            </div>
          </div>
        </div>
      </div>

      <div class="stage-bottom">
        <button class="btn" id="clearBtn">Rydd alle val</button>
        <button class="btn primary" id="generateBtn" disabled>Lag undervisningsforslag</button>
      </div>
    </section>

    <aside class="panel">
      <div class="panel-head">
        <span class="eyebrow" id="panelEyebrow">Kom i gang</span>
        <h2 id="panelTitle">Vel ein kategori</h2>
        <p id="panelDesc">Klikk på eit av felta i hjulet. Start gjerne med «Struktur».</p>
      </div>
      <div class="panel-body" id="panelBody">
        <div class="hint">
          <b>Tre steg:</b><br>
          1. Vel struktur for resultatet.<br>
          2. Vel minst eitt fag og skriv gjerne inn emne.<br>
          3. Legg til dei rammene du ønskjer.
        </div>
        <div class="summary">
          <h3>Vala dine</h3>
          <div class="summary-items" id="summary"></div>
        </div>
      </div>
    </aside>
  </main>
</div>

<div class="modal-backdrop show" id="welcomeModal" aria-modal="true" role="dialog">
  <div class="modal">
    <button class="close" data-close="welcomeModal" aria-label="Lukk">×</button>
    <span class="eyebrow">Velkomen</span>
    <h2>Planlegg undervisning utan å byrja med ein prompt.</h2>
    <p>
      Denne prototypen let deg byggja eit undervisningsopplegg gjennom konkrete val.
      Du kan bruka han direkte i nettlesaren – ingen data blir sende nokon stad.
    </p>
    <div class="steps">
      <div class="step"><strong>1</strong><b>Vel struktur</b><span>Idéar, aktivitet, leksjonsplan eller forløp.</span></div>
      <div class="step"><strong>2</strong><b>Vel fag</b><span>Vel eitt eller fleire fag og legg til tema.</span></div>
      <div class="step"><strong>3</strong><b>Legg til rammer</b><span>Didaktikk, elevmedverknad, vurdering, teknologi m.m.</span></div>
    </div>
    <div class="modal-actions">
      <button class="btn" data-close="welcomeModal">Hopp over</button>
      <button class="btn primary" id="tourStartBtn">Start med struktur</button>
    </div>
  </div>
</div>

<div class="modal-backdrop result-modal" id="resultModal" aria-modal="true" role="dialog">
  <div class="modal">
    <button class="close" data-close="resultModal" aria-label="Lukk">×</button>
    <span class="eyebrow">Forslag</span>
    <h2>Undervisningsutkast</h2>
    <div class="result-toolbar">
      <div class="notice">Dette er eit lokalt generert utkast basert på vala dine. Tilpass alltid mål, innhald og aktivitetar til elevgruppa og læreplanen.</div>
      <div>
        <button class="btn" id="copyBtn">Kopier tekst</button>
        <button class="btn primary" id="downloadBtn">Last ned .txt</button>
      </div>
    </div>
    <div class="result" id="resultContent"></div>
  </div>
</div>

<div class="toast" id="toast">Kopiert</div>

<script>
const categories = [
  {
    id:"struktur", title:"Struktur", required:true,
    desc:"Kva slags resultat ønskjer du å arbeida vidare med?",
    mode:"single",
    options:["10 raske idéar","Aktivitet","Leksjonsplan","Undervisningsforløp"]
  },
  {
    id:"fag", title:"Fagområde, emne", required:true,
    desc:"Vel eitt eller fleire fag. Du kan òg skriva inn tema og klassesteg.",
    mode:"multi",
    options:["Norsk","Matematikk","Engelsk","Naturfag","Samfunnsfag","KRLE","Kunst og handverk","Musikk","Kroppsøving","Mat og helse","Framandspråk","Tverrfagleg"],
    extra:[
      {type:"text", key:"emne", label:"Emne / tema", placeholder:"Til dømes berekraft, brøk, argumenterande tekst …"},
      {type:"select", key:"trinn", label:"Klassesteg", options:["Ikkje valt","1.–2. trinn","3.–4. trinn","5.–7. trinn","8.–10. trinn","Vidaregåande / studentar"]},
      {type:"textarea", key:"fagnotat", label:"Anna fagleg kontekst", placeholder:"Lokale mål, føresetnader, særlege krav …"}
    ]
  },
  {
    id:"pedagogikk", title:"Pedagogiske tilnærmingar",
    desc:"Vel overordna læringssyn eller pedagogiske prinsipp.",
    mode:"multi",
    options:["Utforskande læring","Problembasert læring","Prosjektbasert læring","Samarbeidslæring","Sosiokulturell læring","Leikande læring","Skapande / maker","Erfaringslæring","UDL / universell utforming","Restorativ praksis"]
  },
  {
    id:"didaktikk", title:"Didaktiske tilnærmingar",
    desc:"Vel korleis undervisninga skal strukturerast og læringa arbeidast fram.",
    mode:"multi",
    options:["Baklengs planlegging","Induktiv tilnærming","Deduktiv tilnærming","Dialogisk undervisning","Stasjonsundervisning","Multimodal læring","Flipped classroom","Utforskande syklus","Modellering og gradvis frigjering"]
  },
  {
    id:"leiing", title:"Klasseromsleiing",
    desc:"Legg inn rammer som kan skapa tryggleik, struktur og deltaking.",
    mode:"multi",
    options:["Tydleg struktur","Føreseielege overgangar","Relasjonsbygging","Aktive forventningar","Gruppesamansetjing","Tilpassa opplæring","Støtte ved lese- og skrivevanskar","Låg terskel for deltaking"],
    extra:[{type:"textarea", key:"elevgruppe", label:"Om elevgruppa", placeholder:"Kva bør planen ta omsyn til? Unngå personopplysningar."}]
  },
  {
    id:"innsats", title:"Særlege innsatsar",
    desc:"Vel ferdigheiter eller område du ønskjer å styrkja.",
    mode:"multi",
    options:["Lesing","Skriving","Munnlege ferdigheiter","Rekning","Kritisk tenking","Kjeldekritikk","Digital dømmekraft","Trivsel","Rørsle","Framtidskompetansar","Djupnelæring"]
  },
  {
    id:"stemning", title:"Stemningar, kjensler",
    desc:"Kva slags oppleving eller energi ønskjer du å skapa?",
    mode:"multi",
    options:["Nysgjerrigheit","Ro","Leik","Undring","Mot","Humor","Fordjuping","Meistring","Spenning","Tilhøyrsle"]
  },
  {
    id:"rom", title:"Rom",
    desc:"Kvar skal læringa føregå?",
    mode:"multi",
    options:["Klasserom","Uteområde","Skulegarden","Bibliotek","Verkstad / makerspace","Kjøken","Gymsal","Nærmiljø","Digitalt rom","Hybrid undervisning"]
  },
  {
    id:"medverknad", title:"Elevmedverknad",
    desc:"Vel korleis elevane skal få påverka, skapa eller vurdera.",
    mode:"multi",
    options:["Val mellom oppgåver","Medbestemming","Elevspørsmål styrer undersøkinga","Elevskapte produkt","Læringspartnar","Kameratrespons","Elevane underviser kvarandre","Felles kriterium","Eigenvurdering"]
  },
  {
    id:"vurdering", title:"Vurdering",
    desc:"Vel korleis læring kan fangast opp undervegs eller til slutt.",
    mode:"multi",
    options:["Exit-lapp","Observasjon","Læringssamtale","Eigenvurdering","Kameratvurdering","Vurderingsrubrikk","Omgrepskart","Mini-whiteboard","Kort quiz","Produkt / framføring"]
  },
  {
    id:"teknologi", title:"Teknologi, materiale",
    desc:"Vel ressursar og medium som skal eller ikkje skal inngå.",
    mode:"multi",
    options:["Utan skjerm","Papir og papp","Konkrete materiale","Nettbrett / PC","Lydopptak","Video","Programmering","KI-verktøy","VR / AR","Sensorar / datalogging","Samskrivingsverktøy"]
  }
];

const state = {
  selected: {},
  extras: {},
  active: null
};

categories.forEach(c => state.selected[c.id] = []);

const wheel = document.getElementById("wheel");
const panelTitle = document.getElementById("panelTitle");
const panelDesc = document.getElementById("panelDesc");
const panelEyebrow = document.getElementById("panelEyebrow");
const panelBody = document.getElementById("panelBody");
const summary = document.getElementById("summary");
const generateBtn = document.getElementById("generateBtn");
const progressPill = document.getElementById("progressPill");
const requiredPill = document.getElementById("requiredPill");

function buildWheel(){
  categories.forEach((cat, i)=>{
    const angle = (360/categories.length)*i;
    const btn = document.createElement("button");
    btn.className = "wheel-item";
    btn.style.setProperty("--a", `${angle}deg`);
    btn.dataset.id = cat.id;
    btn.dataset.count = "0";
    btn.innerHTML = cat.title.replace(", ","<br>");
    btn.addEventListener("click", ()=> openCategory(cat.id));
    wheel.appendChild(btn);
  });
}

function openCategory(id){
  state.active = id;
  const cat = categories.find(c=>c.id===id);
  document.querySelectorAll(".wheel-item").forEach(b=>b.classList.toggle("active", b.dataset.id===id));
  panelEyebrow.textContent = cat.required ? "Påkravd val" : "Valfri ramme";
  panelTitle.textContent = cat.title;
  panelDesc.textContent = cat.desc;

  const body = document.createElement("div");

  const grid = document.createElement("div");
  grid.className = "option-grid";
  cat.options.forEach(opt=>{
    const chip = document.createElement("button");
    chip.className = "chip" + (state.selected[id].includes(opt) ? " selected" : "");
    chip.textContent = opt;
    chip.addEventListener("click", ()=>{
      if(cat.mode==="single"){
        state.selected[id] = state.selected[id].includes(opt) ? [] : [opt];
      } else {
        state.selected[id] = state.selected[id].includes(opt)
          ? state.selected[id].filter(x=>x!==opt)
          : [...state.selected[id], opt];
      }
      openCategory(id);
      updateUI();
    });
    grid.appendChild(chip);
  });
  body.appendChild(grid);

  (cat.extra || []).forEach(field=>{
    const wrap = document.createElement("div");
    wrap.className = "field";
    const lab = document.createElement("label");
    lab.textContent = field.label;
    wrap.appendChild(lab);
    let el;
    if(field.type==="textarea"){
      el=document.createElement("textarea");
      el.placeholder=field.placeholder || "";
    } else if(field.type==="select"){
      el=document.createElement("select");
      field.options.forEach(o=>{
        const option=document.createElement("option");
        option.textContent=o; option.value=o;
        el.appendChild(option);
      });
    } else {
      el=document.createElement("input");
      el.type="text"; el.placeholder=field.placeholder || "";
    }
    el.value = state.extras[field.key] || "";
    el.addEventListener("input", ()=>{
      state.extras[field.key]=el.value;
      updateUI();
    });
    wrap.appendChild(el);
    if(field.key==="elevgruppe"){
      const helper=document.createElement("div");
      helper.className="helper";
      helper.textContent="Skriv berre pedagogisk relevant informasjon. Ikkje legg inn namn eller andre personopplysningar.";
      wrap.appendChild(helper);
    }
    body.appendChild(wrap);
  });

  const sum = document.createElement("div");
  sum.className="summary";
  sum.innerHTML="<h3>Vala dine</h3><div class='summary-items' id='summary'></div>";
  body.appendChild(sum);

  panelBody.innerHTML="";
  panelBody.appendChild(body);
  renderSummary(panelBody.querySelector("#summary"));
}

function renderSummary(target=summary){
  if(!target) return;
  target.innerHTML="";
  const rows = categories
    .map(cat=>{
      const values = state.selected[cat.id];
      if(!values.length) return null;
      return {label:cat.title, value:values.join(", ")};
    }).filter(Boolean);

  if(state.extras.emne) rows.push({label:"Emne",value:state.extras.emne});
  if(state.extras.trinn && state.extras.trinn!=="Ikkje valt") rows.push({label:"Klassesteg",value:state.extras.trinn});

  if(!rows.length){
    target.innerHTML="<div class='hint'>Ingen val enno.</div>";
    return;
  }
  rows.forEach(r=>{
    const div=document.createElement("div");
    div.className="summary-row";
    div.innerHTML=`<b>${escapeHtml(r.label)}</b><span>${escapeHtml(r.value)}</span>`;
    target.appendChild(div);
  });
}

function updateUI(){
  categories.forEach(cat=>{
    const btn=document.querySelector(`.wheel-item[data-id="${cat.id}"]`);
    const count=state.selected[cat.id].length;
    btn.dataset.count=count;
    btn.classList.toggle("has-value",count>0);
  });
  const chosenCats=categories.filter(c=>state.selected[c.id].length).length;
  progressPill.textContent=`${chosenCats} ${chosenCats===1?"kategori":"kategoriar"} valde`;

  const hasStructure=state.selected.struktur.length>0;
  const hasSubject=state.selected.fag.length>0 || !!state.extras.emne;
  generateBtn.disabled=!(hasStructure && hasSubject);

  if(!hasStructure && !hasSubject){
    requiredPill.textContent="Vel struktur og fag/emne for å koma i gang";
  } else if(!hasStructure){
    requiredPill.textContent="Du manglar struktur";
  } else if(!hasSubject){
    requiredPill.textContent="Du manglar fag eller emne";
  } else {
    requiredPill.textContent="Klar til å laga forslag";
    requiredPill.classList.remove("warn");
  }
  document.querySelectorAll(".summary-items").forEach(el=>renderSummary(el));
}

function resetAll(){
  categories.forEach(c=>state.selected[c.id]=[]);
  state.extras={};
  state.active=null;
  document.querySelectorAll(".wheel-item").forEach(b=>b.classList.remove("active"));
  panelEyebrow.textContent="Kom i gang";
  panelTitle.textContent="Vel ein kategori";
  panelDesc.textContent="Klikk på eit av felta i hjulet. Start gjerne med «Struktur».";
  panelBody.innerHTML=`
    <div class="hint">
      <b>Tre steg:</b><br>
      1. Vel struktur for resultatet.<br>
      2. Vel minst eitt fag og skriv gjerne inn emne.<br>
      3. Legg til dei rammene du ønskjer.
    </div>
    <div class="summary"><h3>Vala dine</h3><div class="summary-items" id="summary"></div></div>`;
  updateUI();
}

function join(list, fallback="ikkje spesifisert"){
  return list && list.length ? list.join(", ") : fallback;
}
function sentenceList(list){
  if(!list || !list.length) return "";
  if(list.length===1) return list[0];
  return list.slice(0,-1).join(", ")+" og "+list.at(-1);
}
function escapeHtml(str=""){
  return String(str).replace(/[&<>"']/g, m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[m]));
}

function buildPlan(){
  const structure=state.selected.struktur[0] || "Undervisningsopplegg";
  const subjects=join(state.selected.fag);
  const topic=state.extras.emne || "eit relevant fagleg tema";
  const grade=(state.extras.trinn && state.extras.trinn!=="Ikkje valt") ? state.extras.trinn : "vald elevgruppe";

  const pedagogy=state.selected.pedagogikk;
  const didactics=state.selected.didaktikk;
  const management=state.selected.leiing;
  const efforts=state.selected.innsats;
  const moods=state.selected.stemning;
  const rooms=state.selected.rom;
  const participation=state.selected.medverknad;
  const assessment=state.selected.vurdering;
  const tech=state.selected.teknologi;

  let purpose = `Elevane skal arbeida med ${topic} i ${subjects}, med vekt på å forstå, utforska og kunna bruka sentrale omgrep eller ferdigheiter i ein meiningsfull samanheng.`;
  if(efforts.length) purpose += ` Opplegget skal særleg støtta ${sentenceList(efforts).toLowerCase()}.`;

  let opening = moods.length
    ? `Start med eit kort anslag som skaper ${sentenceList(moods).toLowerCase()}. Presenter eit spørsmål, fenomen, bilete, gjenstand eller problem som elevane kan reagera på før læraren forklarer for mykje.`
    : `Start med eit kort anslag: eit spørsmål, fenomen, bilete, gjenstand eller problem som vekkjer nysgjerrigheit og gjer temaet relevant.`;

  let main = participation.length
    ? `La elevane få ei aktiv rolle gjennom ${sentenceList(participation).toLowerCase()}. Arbeidet kan organiserast i korte fasar: utforsking, idéutvikling, utprøving og deling.`
    : `La elevane arbeida aktivt med ei oppgåve der dei må undersøka, prøva ut, forklara og dela tankane sine med andre.`;

  if(pedagogy.length) main += ` Den pedagogiske retninga er ${sentenceList(pedagogy).toLowerCase()}.`;
  if(didactics.length) main += ` Didaktisk kan opplegget byggja på ${sentenceList(didactics).toLowerCase()}.`;

  let teacher = `Læraren set tydelege rammer, modellerer det som trengst, stiller opne oppfølgingsspørsmål og bruker observasjonar frå elevane sitt arbeid til å justera støtta undervegs.`;
  if(management.length) teacher += ` Ha særleg merksemd på ${sentenceList(management).toLowerCase()}.`;
  if(state.extras.elevgruppe) teacher += ` Omsyn til elevgruppa: ${state.extras.elevgruppe}`;

  let ending = assessment.length
    ? `Avslutt med ${sentenceList(assessment).toLowerCase()} for å synleggjera kva elevane har forstått, kva dei framleis lurer på, og kva som bør følgjast opp vidare.`
    : `Avslutt med ei kort oppsummering der elevane formulerer kva dei har lært, kva som overraska dei, og eitt spørsmål dei framleis har.`;

  let resources = [];
  if(rooms.length) resources.push(`rom: ${join(rooms)}`);
  if(tech.length) resources.push(`teknologi/materiale: ${join(tech)}`);
  const resourceText = resources.length ? resources.join(" · ") : "Vel ressursar ut frå lokale rammer og fagleg føremål.";

  let body="";
  if(structure==="10 raske idéar"){
    const ideaSeeds = [
      "Gjer temaet om til eit mysterium elevane må løysa.",
      "La elevane laga tre moglege forklaringar og testa kva som held.",
      "Bruk eit konkret objekt eller bilete som startpunkt for faglege spørsmål.",
      "La elevane laga eit produkt for ein ekte mottakar.",
      "Lag ein fysisk stasjon der elevane samlar data eller observasjonar.",
      "La elevane samanlikna to motstridande forklaringar eller perspektiv.",
      "Be elevane laga ein enkel modell, skisse eller prototype.",
      "La elevane undervisa ein annan gruppe i det viktigaste dei har funne ut.",
      "Avslutt med at elevane endrar eller forbetrar den første ideen sin.",
      "Knyt temaet til nærmiljøet, kvardagen eller ei aktuell problemstilling."
    ];
    body = `<h3>10 raske idéar</h3><ul>${ideaSeeds.map(x=>`<li>${escapeHtml(x)}</li>`).join("")}</ul>`;
  } else if(structure==="Aktivitet"){
    body = `
      <h3>Aktivitet – 30–45 minutt</h3>
      <ul>
        <li><b>5 min:</b> ${escapeHtml(opening)}</li>
        <li><b>20–30 min:</b> ${escapeHtml(main)}</li>
        <li><b>5–10 min:</b> ${escapeHtml(ending)}</li>
      </ul>`;
  } else if(structure==="Leksjonsplan"){
    body = `
      <h3>Leksjonsplan – om lag 60 minutt</h3>
      <ul>
        <li><b>0–10 min:</b> ${escapeHtml(opening)}</li>
        <li><b>10–20 min:</b> Felles klargjering av oppdrag, omgrep og kriterium.</li>
        <li><b>20–45 min:</b> ${escapeHtml(main)}</li>
        <li><b>45–55 min:</b> Deling, samanlikning og fagleg samtale.</li>
        <li><b>55–60 min:</b> ${escapeHtml(ending)}</li>
      </ul>`;
  } else {
    body = `
      <h3>Forslag til undervisningsforløp</h3>
      <ul>
        <li><b>Fase 1 – opning og undring:</b> ${escapeHtml(opening)}</li>
        <li><b>Fase 2 – utforsking:</b> Elevane samlar informasjon, testar idear og utviklar faglege spørsmål.</li>
        <li><b>Fase 3 – skaping og bearbeiding:</b> ${escapeHtml(main)}</li>
        <li><b>Fase 4 – deling og respons:</b> Elevane viser fram førebelse løysingar og får respons frå medelevar og lærar.</li>
        <li><b>Fase 5 – revisjon og vurdering:</b> ${escapeHtml(ending)}</li>
      </ul>`;
  }

  const contextNotes = [state.extras.fagnotat].filter(Boolean).join(" ");

  return `
    <h3>Kontekst</h3>
    <p><b>${escapeHtml(structure)}</b> for <b>${escapeHtml(grade)}</b> i <b>${escapeHtml(subjects)}</b>. Tema: <b>${escapeHtml(topic)}</b>.</p>
    ${contextNotes ? `<p>${escapeHtml(contextNotes)}</p>` : ""}

    <h3>Mål og retning</h3>
    <p>${escapeHtml(purpose)}</p>

    ${body}

    <h3>Lærarrolla</h3>
    <p>${escapeHtml(teacher)}</p>

    <h3>Ressursar og læringsrom</h3>
    <p>${escapeHtml(resourceText)}</p>

    <h3>Vidare tilpassing</h3>
    <p>Kontroller at aktivitetane heng saman med kompetansemål, elevane sine forkunnskapar og tida du faktisk har. Fjern element som ikkje støttar målet, og legg inn konkret faginnhald før gjennomføring.</p>
  `;
}

function stripHtml(html){
  const temp=document.createElement("div");
  temp.innerHTML=html;
  return temp.innerText;
}

function showToast(text){
  const t=document.getElementById("toast");
  t.textContent=text;
  t.classList.add("show");
  clearTimeout(window.__toast);
  window.__toast=setTimeout(()=>t.classList.remove("show"),1600);
}

buildWheel();
updateUI();

document.querySelectorAll("[data-close]").forEach(btn=>{
  btn.addEventListener("click", ()=>document.getElementById(btn.dataset.close).classList.remove("show"));
});
document.getElementById("helpBtn").addEventListener("click", ()=>document.getElementById("welcomeModal").classList.add("show"));
document.getElementById("tourStartBtn").addEventListener("click", ()=>{
  document.getElementById("welcomeModal").classList.remove("show");
  openCategory("struktur");
});
document.getElementById("resetBtn").addEventListener("click", resetAll);
document.getElementById("clearBtn").addEventListener("click", resetAll);

document.getElementById("generateBtn").addEventListener("click", ()=>{
  document.getElementById("resultContent").innerHTML=buildPlan();
  document.getElementById("resultModal").classList.add("show");
});
document.getElementById("copyBtn").addEventListener("click", async ()=>{
  const text=stripHtml(document.getElementById("resultContent").innerHTML);
  try{
    await navigator.clipboard.writeText(text);
    showToast("Kopiert til utklippstavla");
  }catch{
    showToast("Kunne ikkje kopiera automatisk");
  }
});
document.getElementById("downloadBtn").addEventListener("click", ()=>{
  const text=stripHtml(document.getElementById("resultContent").innerHTML);
  const blob=new Blob([text],{type:"text/plain;charset=utf-8"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download="undervisningsutkast.txt";
  a.click();
  URL.revokeObjectURL(url);
});

document.addEventListener("keydown", e=>{
  if(e.key==="Escape"){
    document.querySelectorAll(".modal-backdrop.show").forEach(m=>m.classList.remove("show"));
  }
});
</script>
</body>
</html>
